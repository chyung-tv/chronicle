# OpenRouter. Leave the key unset to run with the heuristic mock LLM.
OPENROUTER_API_KEY=
PLAYOUT_LLM_BASE_URL=https://openrouter.ai/api/v1
PLAYOUT_ACTOR_MODEL=deepseek/deepseek-v4-flash-0731
PLAYOUT_STRONG_MODEL=deepseek/deepseek-v4-flash-0731
PLAYOUT_LLM_MODE=
PLAYOUT_DB=playout.db
PLAYOUT_API_ORIGIN=http://127.0.0.1:8765

# Local SQLite is the default. On Railway, set DATABASE_URL to the Postgres plugin
# (${{Postgres.DATABASE_URL}}) and the catalog + per-story canon live in Postgres.
# DATABASE_URL=
# PLAYOUT_WORKER=inline   # API process drains jobs (local/tests)
# PLAYOUT_WORKER=external # dedicated `python -m playout.worker` (Railway)
